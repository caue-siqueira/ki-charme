# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# As variáveis VITE_ são públicas e incluídas no JavaScript do navegador.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# Usadas pelas funções autenticadas no servidor.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# Só adicione se uma função de servidor exigir acesso administrativo.
# Nunca use uma chave service_role/secret em uma variável VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
